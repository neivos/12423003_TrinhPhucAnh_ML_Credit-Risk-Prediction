# --- 1. Python & Cache ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- 2. Virtual Environments (Môi trường ảo) ---
env/
venv/
.venv/
.env

# --- 3. Dữ liệu & Models (QUAN TRỌNG) ---
# Không upload dữ liệu gốc
data/*.csv
data/*.xlsx

# Không upload file model (pkl) vì chúng là file nhị phân, thay đổi liên tục
data/pkl/*.pkl
# Hoặc nếu muốn chặn toàn bộ thư mục data thì dùng dòng dưới:
# data/

# --- 4. Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/

# --- 5. IDE Settings (VS Code, PyCharm) ---
.vscode/
.idea/

# --- 6. Streamlit ---
# Chứa secrets password (không bao giờ được public)
.streamlit/secrets.toml

# --- 7. System Files ---
.DS_Store
Thumbs.db
